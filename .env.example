# ---------------------------------------------------------------------------
# Yalla Shoot | يلا شوت — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# On Vercel: Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Public canonical URL of the site (no trailing slash). Used for canonical
# links, sitemap and Open Graph. On Vercel it falls back to the production
# domain automatically if left empty.
NEXT_PUBLIC_SITE_URL=

# Optional public contact e-mail shown on /contact.
SITE_CONTACT_EMAIL=

# --- Football data provider ------------------------------------------------
# Supported provider: api-football (API-Sports v3, https://www.api-football.com)
FOOTBALL_API_PROVIDER=api-football
# Your API-Sports key (dashboard.api-football.com). Server-side only.
FOOTBALL_API_KEY=
# Official base URL. Only change it for tests (mock server) or a proxy you control.
FOOTBALL_API_BASE_URL=https://v3.football.api-sports.io
# Request timeout in milliseconds.
FOOTBALL_API_TIMEOUT_MS=8000
# Optional overrides. Normally detected from the provider's rate-limit headers.
FOOTBALL_API_DAILY_LIMIT=
FOOTBALL_API_MINUTE_LIMIT=
# Percentage of the daily quota reserved for critical requests (today/live).
FOOTBALL_API_RESERVE_PERCENT=10
# Optional multiplier for cache freshness (e.g. 2 = refresh half as often).
# Empty = automatic (free plan with 100 req/day uses 10x longer intervals).
FOOTBALL_TTL_SCALE=

# --- Persistent storage (strongly recommended in production) ---------------
# Upstash Redis REST credentials. Used for: shared cache across serverless
# instances, last-known-good data, quota tracking, admin content & settings.
# The Vercel Marketplace integration exposes KV_REST_API_URL / KV_REST_API_TOKEN,
# which are accepted too.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Admin panel -------------------------------------------------------------
# The admin panel stays disabled until all three are set. No default password.
ADMIN_USERNAME=
# Generate with: npm run admin:hash -- "a-long-unique-password"
ADMIN_PASSWORD_HASH=
# Random secret (32+ characters), e.g.: openssl rand -base64 48
ADMIN_SESSION_SECRET=
# Optional second account limited to editorial content (news/annotations).
EDITOR_USERNAME=
EDITOR_PASSWORD_HASH=

# --- Cron ---------------------------------------------------------------------
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" automatically.
CRON_SECRET=

# --- News feeds (optional) ------------------------------------------------------
# Comma-separated host names allowed for licensed RSS feeds added in the admin
# panel. Empty = any public HTTPS host (private/internal addresses are always blocked).
NEWS_FEED_ALLOWED_HOSTS=

# --- Security headers (read at build time) -------------------------------------
# frame-ancestors CSP value. Keep 'none' unless you must embed the site.
FRAME_ANCESTORS='none'
# Extra image hosts allowed by CSP (space or comma separated, with scheme).
EXTRA_IMAGE_HOSTS=
# Extra dev-server origins (host names) for `next dev` behind a tunnel/preview.
ALLOWED_DEV_ORIGINS=
